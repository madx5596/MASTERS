# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/beautykrk

# JWT
JWT_SECRET=change-this-in-production-use-long-random-string
JWT_REFRESH_SECRET=change-this-in-production-use-another-long-random-string

# YooKassa
YOOKASSA_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:3000/payment/return

# Payment mode: 'mock' for development, 'production' for real payments
PAYMENT_MODE=mock

# App URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
